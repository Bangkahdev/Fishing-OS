#!/usr/bin/env bash
# Helper untuk mengelola Docker daemon

case "${1:-}" in
    up)
        sudo systemctl start docker
        echo "Docker daemon dijalankan. Catatan: image disimpan di RAM (tmpfs)."
        ;;
    down)
        sudo systemctl stop docker
        echo "Docker daemon dihentikan."
        ;;
    status)
        if sudo systemctl is-active --quiet docker && sudo docker info >/dev/null 2>&1; then
            echo "Docker daemon aktif."
        else
            echo "Docker daemon tidak aktif. Jalankan: fishing-container up"
        fi
        ;;
    *)
        echo "Penggunaan: fishing-container {up|down|status}"
        ;;
esac
