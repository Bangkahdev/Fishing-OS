#!/usr/bin/env bash
# Cek versi alat pemrograman yang terpasang.
# Daftar harus sinkron dengan profile/packages.x86_64: alat yang tidak
# ada di ISO tidak boleh ditampilkan sebagai "belum terpasang" (mis.
# rustc dan java sengaja tidak disertakan agar ukuran ISO tetap di bawah
# batas aset GitHub 2 GiB).

echo "===== Fishing OS - Alat Pemrograman Tersedia ====="
echo

check() {
    if command -v "$1" >/dev/null 2>&1; then
        printf "%-18s %s\n" "$1" "$("$1" --version 2>/dev/null | head -n1 || "$1" version 2>/dev/null | head -n1)"
    else
        printf "%-18s %s\n" "$1" "(belum terpasang)"
    fi
}

check git
check gh
check docker
check docker-compose
check kubectl
check helm
check terraform
check ansible
check python3
check node
check go
check make
check cmake
check gcc
check jq
check ssh

echo
echo "Selamat ngoding! 🎣"
