#!/usr/bin/env bash
# Cek versi alat pemrograman yang terpasang

echo "===== Fishing OS - Alat Pemrograman Tersedia ====="
echo

check() {
    if command -v "$1" >/dev/null 2>&1; then
        printf "%-18s %s\n" "$1" "$("$1" --version 2>/dev/null | head -n1 || "$1" version 2>/dev/null | head -n1)"
    else
        printf "%-18s %s\n" "$1" "(belum terpasang)"
    fi
}

check git
check gh
check docker
check docker-compose
check kubectl
check helm
check terraform
check ansible
check python3
check node
check go
check rustc
check java
check make
check cmake
check gcc
check jq
check ssh

echo
echo "Selamat ngoding! 🎣"
