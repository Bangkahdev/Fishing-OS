#!/usr/bin/env bash
# Cek versi alat pemrograman yang terpasang.
# Daftar harus sinkron dengan profile/packages.x86_64: alat yang tidak
# ada di ISO tidak boleh ditampilkan sebagai "belum terpasang" (mis.
# rustc dan java sengaja tidak disertakan agar ukuran ISO tetap di bawah
# batas aset GitHub 2 GiB).
#
# Setiap alat punya perintah versinya sendiri dan dibungkus timeout agar
# tidak ada yang menggantung menunggu jaringan (mis. kubectl yang mencoba
# menghubungi API server saat dipanggil tanpa --client).

echo "===== Fishing OS - Alat Pemrograman Tersedia ====="
echo

check() {
    local cmd="$1"
    local args="$2"
    local out

    if ! command -v "$cmd" >/dev/null 2>&1; then
        printf "%-18s %s\n" "$cmd" "(belum terpasang)"
        return
    fi

    # shellcheck disable=SC2086
    out=$(timeout 8 "$cmd" $args 2>&1 | head -n1)
    [ -n "$out" ] || out="(versi tidak terbaca)"
    printf "%-18s %s\n" "$cmd" "$out"
}

check git            "--version"
check gh             "--version"
check docker         "--version"
check docker-compose "version"
check kubectl        "version --client"
check helm           "version --short"
check terraform      "version"
check ansible        "--version"
check python3        "--version"
check node           "--version"
check go             "version"
check make           "--version"
check cmake          "--version"
check gcc            "--version"
check jq             "--version"
check ssh            "-V"

echo
echo "Selamat ngoding!"
