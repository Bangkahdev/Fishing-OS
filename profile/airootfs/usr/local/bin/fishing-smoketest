#!/usr/bin/env bash
# Smoke test di dalam ISO. Dijalankan oleh fishing-smoketest.service hanya
# jika kernel diberi parameter fishing.test=1 (lihat tests/test_iso.sh).
# Semua keluaran berawalan penanda agar mudah dicari di konsol serial.

# Jika tidak dijalankan melalui parameter kernel, keluar diam-diam.
if ! grep -q 'fishing.test=1' /proc/cmdline 2>/dev/null; then
    exit 0
fi

P="FISHING-SMOKETEST:"
fail=0

echo "$P START"

for tool in git docker kubectl helm terraform ansible python3 node go jq ssh make gcc curl tmux nvim vim; do
    if command -v "$tool" >/dev/null 2>&1; then
        echo "$P OK $tool"
    else
        echo "$P MISSING $tool"
        fail=$((fail + 1))
    fi
done

if grep -q '^NAME="Fishing OS"' /etc/os-release; then
    echo "$P OK os-release"
else
    echo "$P BAD os-release (NAME bukan Fishing OS)"
    fail=$((fail + 1))
fi

echo "$P INFO unit gagal: $(systemctl --failed --no-legend 2>/dev/null | wc -l)"

# Cek sesi desktop (XFCE). Hanya dijalankan bila kernel diberi parameter
# fishing.test.desktop=1, karena runner CI tidak punya display.
if grep -q 'fishing.test.desktop=1' /proc/cmdline 2>/dev/null; then
    wait_s="${FISHING_DESKTOP_WAIT:-300}"
    echo "$P INFO menunggu sesi desktop (maks ${wait_s}s)"
    deadline=$((SECONDS + wait_s))
    while (( SECONDS < deadline )); do
        pgrep -x xfce4-session >/dev/null 2>&1 && break
        sleep 2
    done
    if pgrep -x xfce4-session >/dev/null 2>&1; then
        echo "$P OK xfce4-session berjalan"
    else
        echo "$P MISSING xfce4-session tidak berjalan"
        fail=$((fail + 1))
    fi

    echo "$P --- lightdm: status ---"
    systemctl is-enabled lightdm 2>&1 | sed "s|^|$P |"
    systemctl is-active lightdm 2>&1 | sed "s|^|$P |"
    echo "$P --- sesi login ---"
    loginctl list-sessions --no-legend 2>&1 | sed "s|^|$P |"
    echo "$P --- home liveuser ---"
    ls -ld /home/liveuser 2>&1 | sed "s|^|$P |"
    echo "$P --- grup liveuser (harus ada 'autologin') ---"
    id liveuser 2>&1 | sed "s|^|$P |"
    echo "$P --- proses X ---"
    pgrep -a -f 'xfce4-session|Xorg|lightdm-gtk' 2>&1 | head -8 | sed "s|^|$P |"
    echo "$P --- .xsession-errors ---"
    head -20 /home/liveuser/.xsession-errors 2>&1 | sed "s|^|$P |"
    # Diagnostik bila sesi gagal: log lightdm & journal user
    if ! pgrep -x xfce4-session >/dev/null 2>&1; then
        echo "$P --- lightdm.log (diagnostik) ---"
        grep -E "Running command|Exited with return value|Writing X server authority" \
            /var/log/lightdm/lightdm.log 2>&1 | tail -25 | sed "s|^|$P |"
        echo "$P --- journal user liveuser (diagnostik) ---"
        journalctl _UID=1000 --no-pager -n 30 2>&1 | tail -25 | sed "s|^|$P |"
    fi
fi

if [[ "$fail" -eq 0 ]]; then
    echo "$P PASS"
else
    echo "$P FAIL ($fail)"
fi
echo "$P END"

systemctl poweroff
