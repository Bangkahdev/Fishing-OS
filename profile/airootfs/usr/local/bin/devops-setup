#!/usr/bin/env bash
# Setup awal Fishing OS DevOps (jalankan sebagai root)

echo "== Setup awal Fishing OS DevOps =="

# Enable layanan dasar
systemctl enable NetworkManager 2>/dev/null || true
systemctl enable sshd 2>/dev/null || true

# Buat user devops jika belum ada
if ! id devops >/dev/null 2>&1; then
    useradd -m -G wheel,docker -s /bin/zsh devops
    echo "User 'devops' dibuat."
else
    echo "User 'devops' sudah ada."
fi

# Izinkan wheel pakai sudo tanpa password (opsional, untuk live ISO)
if [[ ! -f /etc/sudoers.d/devops ]]; then
    echo "%wheel ALL=(ALL:ALL) NOPASSWD:ALL" > /etc/sudoers.d/devops
    chmod 440 /etc/sudoers.d/devops
fi

echo "Selesai. Anda dapat login sebagai 'devops' atau gunakan root langsung."
