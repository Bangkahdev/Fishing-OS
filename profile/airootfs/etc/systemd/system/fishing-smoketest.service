[Unit]
Description=Fishing OS smoke test (hanya aktif dengan fishing.test=1)
ConditionKernelCommandLine=fishing.test=1
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'exec >/dev/ttyS0 2>&1; /usr/local/bin/fishing-smoketest'
StandardOutput=null
StandardError=null
TimeoutStartSec=300
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
