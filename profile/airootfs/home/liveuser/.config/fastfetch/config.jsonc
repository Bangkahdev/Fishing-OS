// Konfigurasi fastfetch untuk Fishing OS.
// Logo ASCII: /usr/share/fishing-os/logo.txt (huruf F).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/share/fishing-os/logo.txt",
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " • ",
    "color": {
      "keys": "cyan",
      "title": "cyan"
    }
  },
  "modules": [
    "title",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "locale",
    "break",
    "colors"
  ]
}
